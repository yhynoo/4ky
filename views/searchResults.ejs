<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="style.css">
    <link rel="icon" href="grain.png">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4ky: <%= term %></title>
</head>
<body class = 'urukContainer'>
    <nav>
        <div class="urukBox urukNav urukSmallText">
            <a href="/">Sign search</a>
            <a href="/about">About</a>
        </div>
    </nav>

    <div class='urukBox'>
        <h1>Search results for "<%= term %>"</h1>
    </div>

    <% if (Object.keys(data.lexicalItems).length > 0) { %>
        <div class="urukBox">
            <h2>Lexical attestations (<%= data.lexicalItemsCount %> witnesses)</h2>

            <div class = "urukBox">
                <h3>Lexical contexts <span class="urukSmallText urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('lexicalResults')">Hide / show</a></span></h3>
                <div id = "lexicalResults">
                    <%- data.lexicalItems %>
                </div>
            </div>
        </div>
    <% } %>

    <% if (data.economicAttestations) { %>
        <div class="urukBox">
            <% if (data.isCoordinated) { %>
                <h2>Administrative attestations (<%= data.economicAccountsCount %> accounts)</h2>
            <% } else { %>
                <h2>Administrative attestations (<%= data.economicAttestationsCount %> matches in <%= data.economicAccountsCount %> accounts)</h2>
            <% } %>

            <div class = "urukBox" id = "economicResults">
                <h3>Semantic contexts <span class="urukSmallText urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('semanticResults')">Hide / show</a></span></h3>
                <div id = "semanticResults" style = "padding-bottom: 1em; display: none;">
                    <% if (data.statistics.compoundsHTML !== '') { %>
                        <div class='urukAttestation urukSmallText'>
                            <div class="urukLine">
                                <b>Most common split compounds</b>
                                <%- data.jsonButtonCompounds %>
                            </div>
                            <%- data.statistics.compoundsHTML %>
                        </div>
                    <% } %>
                    
                    <% if (data.statistics.lineCountsHTML !== '') { %>
                        <div class='urukAttestation urukSmallText'>
                            <div class="urukLine">
                                <b>Other signs in the same case</b>
                                <%- data.jsonButtonLine %>
                            </div>
                            <%- data.statistics.lineCountsHTML %>
                        </div>
                    <% } %>
        
                    <% if (data.statistics.tabletCountsHTML !== '') { %>
                        <div class='urukAttestation urukSmallText'>
                            <div class="urukLine">
                                <b>Other signs in the same account</b>
                                <%- data.jsonButtonTablet %>
                            </div>
                            <%- data.statistics.tabletCountsHTML %>
                        </div>
                    <% } %>
        
                    <!--
                        <% if (data.statistics.accountTypeHTML !== '') { %>
                            <div class='urukAttestation urukSmallText'>
                                <b>Account types</b>
                                <span class="urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('accountTypes')">Hide / show</a></span>
                                <div id = "accountTypes" style="display: none;">
                                    <%- data.statistics.accountTypeHTML %>
                                </div>
                            </div>
                        <% } %>
                    -->
                </div>
                <br>

                <h3>Archaeological contexts <span class="urukSmallText urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('archaeologicalResults')">Hide / show</a></span></h3>
                <div id = "archaeologicalResults" style = "padding-bottom: 1em; display: none;">
                    <% if (data.statistics.distribution !== '') { %>
                        <div class='urukAttestation urukSmallText'>
                            <div class="urukLine">
                                <b>Geographic distribution:</b>
                            </div>
                            <%- data.statistics.distribution %>
                        </div>
                    <% } %>

                    <% if (data.statistics.excavationHTML !== '') { %>
                        <div class='urukAttestation urukSmallText'>
                            <b>Excavation squares in Uruk</b>
                            <span class="urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('excavationSquares')">Hide / show</a></span>

                            <div id = "excavationSquares">
                                <%- data.statistics.excavationGridHTML %>
                            </div>
                        </div>

                        <div class='urukAttestation urukSmallText'>
                            <b>Tablets arranged according to squares</b>
                            <span class="urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('excavationArranged')">Hide / show</a></span><br><br>

                            <div id = "excavationArranged">
                                <%- data.statistics.excavationHTML %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <br>

                <h3 class = "urukLine">
                    <span>
                        Attestations 
                        <span class="urukSmallText urukLabel"><a href="javascript:void(0);" onclick="toggleVisibility('attestations')">Hide / show</a></span>
                    </span>
                    <span class = "urukSmallText"><%- data.jsonButtonEconomic %></span>
                </h3>
                <br>
                <div id = "attestations">
                    <%- data.economicAttestations %>
                </div>
            </div>
        </div>
    <% } else { %>
        No results.
    <% } %>

    <!-- visibility toggler -->
    <script>
        function toggleVisibility(divId) {
            var div = document.getElementById(divId);
            var computedStyle = window.getComputedStyle(div);
            
            if (computedStyle.display === "none") div.style.display = "block";
            else div.style.display = "none";
        }
    </script>
</body>
</html>
